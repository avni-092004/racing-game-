
<div id="turbo-rush" class="w-full flex flex-col gap-3 text-white">
 <style>
 #turbo-rush{font-family:Inter,ui-sans-serif,system-ui,sans-serif}
 #turbo-rush .game-shell{background:linear-gradient(145deg,#101827,#17243a);border:1px solid #34445d;border-radius:18px;padding:12px}
 #turbo-rush canvas{display:block;width:100%;height:auto;aspect-ratio:16/10;border-radius:12px;background:#182b25;touch-action:none}
 #turbo-rush button,#turbo-rush select{border:1px solid #43536b;border-radius:10px;padding:10px 13px;font-weight:700;font-size:13px}
 #turbo-rush button:active{transform:scale(.96)}
 #turbo-rush .primary{background:#f97316;border-color:#fb923c;color:#fff}
 #turbo-rush .secondary{background:#26364c;color:white}
 #turbo-rush .stat{background:#202e42;border-radius:10px;padding:9px;text-align:center;min-width:0}
 #turbo-rush .stat small{display:block;color:#aabbd0;font-size:10px;text-transform:uppercase;letter-spacing:1px}
 #turbo-rush .stat strong{font-size:19px;font-variant-numeric:tabular-nums}
 #turbo-rush .pedal{background:#293b52;color:white;min-width:68px;min-height:58px;touch-action:none}
 #turbo-rush .steer{background:#26364c;color:white;min-width:62px;min-height:54px;font-size:23px}
 #turbo-rush .overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#07101dcc;border-radius:12px;padding:15px}
 #turbo-rush .overlay-card{max-width:340px;width:100%;background:#15243a;border:1px solid #53647a;border-radius:18px;padding:20px;text-align:center;box-shadow:0 15px 45px #0008}
 #turbo-rush .nitro-track{height:9px;background:#344256;border-radius:20px;overflow:hidden}
 #turbo-rush .nitro-fill{height:100%;width:100%;background:linear-gradient(90deg,#06b6d4,#60a5fa);transition:width .1s}
 </style>
 <div class="flex justify-between items-center gap-2 flex-wrap">
  <div><div class="text-orange-400 font-black text-xs tracking-[3px]">ARCADE RACING</div><div class="text-2xl font-black tracking-tight">TURBO <span class="text-orange-400">RUSH</span></div></div>
  <div class="text-xs text-slate-300 text-right">RACE • SURVIVE • DOMINATE<br><span class="text-orange-300">Single Player Championship</span></div>
 </div>
 <div class="grid grid-cols-4 gap-2">
  <div class="stat"><small>Speed</small><strong id="tr-speed">0</strong><small>KM/H</small></div>
  <div class="stat"><small>Distance</small><strong id="tr-distance">0</strong><small>METRES</small></div>
  <div class="stat"><small>Score</small><strong id="tr-score">0</strong><small>POINTS</small></div>
  <div class="stat"><small>Coins</small><strong id="tr-coins">0</strong><small>COLLECTED</small></div>
 </div>
 <div class="game-shell">
  <div class="flex justify-between items-center mb-2 text-xs gap-2"><span class="font-bold text-cyan-300">NITRO BOOST</span><span id="tr-nitro-label" class="text-slate-300">100%</span></div>
  <div class="nitro-track mb-3"><div id="tr-nitro" class="nitro-fill"></div></div>
  <div class="relative">
   <canvas id="tr-canvas" width="800" height="500" aria-label="Racing game screen"></canvas>
   <div id="tr-overlay" class="overlay">
    <div class="overlay-card">
     <div class="text-5xl mb-2">🏎️</div>
     <div class="text-2xl font-black">TURBO RUSH</div>
     <p id="tr-message" class="text-slate-300 text-sm my-3">Ready to race? Dodge traffic, collect coins and use nitro to set your high score!</p>
     <div class="flex justify-center gap-2 text-xs text-slate-300 mb-4"><span>🏁 Traffic</span><span>•</span><span>🪙 Coins</span><span>•</span><span>⚡ Nitro</span></div>
     <button id="tr-start" class="primary w-full text-base">▶ START RACE</button>
    </div>
   </div>
  </div>
  <div class="flex justify-between items-center flex-wrap gap-2 mt-3">
   <div class="text-xs text-slate-300">BEST SCORE: <strong id="tr-best" class="text-yellow-300">0</strong></div>
   <div class="flex gap-2"><button id="tr-pause" class="secondary">Ⅱ PAUSE</button><button id="tr-restart" class="secondary">↻ RESTART</button></div>
  </div>
 </div>
 <div class="grid grid-cols-2 gap-3">
  <div class="game-shell">
   <div class="text-xs font-bold text-slate-300 mb-2">STEERING</div>
   <div class="flex justify-center gap-3">
    <button class="steer" id="tr-left">◀</button>
    <button class="steer" id="tr-right">▶</button>
   </div>
  </div>
  <div class="game-shell">
   <div class="text-xs font-bold text-slate-300 mb-2">SPEED CONTROL</div>
   <div class="flex justify-center gap-2">
    <button class="pedal" id="tr-brake">▼<br><span class="text-[10px]">BRAKE</span></button>
    <button class="pedal primary" id="tr-gas">▲<br><span class="text-[10px]">GAS</span></button>
    <button class="pedal" id="tr-boost">⚡<br><span class="text-[10px]">NITRO</span></button>
   </div>
  </div>
 </div>
 <div class="game-shell">
  <div class="font-bold text-sm mb-2">⚙️ GAME SETTINGS</div>
  <div class="flex items-center justify-between gap-3 flex-wrap">
   <label class="text-sm text-slate-300" for="tr-difficulty">Difficulty</label>
   <select id="tr-difficulty" class="bg-slate-800 text-white"><option value="easy">Easy</option><option value="normal" selected>Normal</option><option value="hard">Hard</option><option value="extreme">Extreme</option></select>
   <button id="tr-sound" class="secondary">🔊 Sound ON</button>
  </div>
  <div class="text-xs text-slate-400 mt-3">Keyboard: ← → or A/D to steer • ↑ or W to accelerate • ↓ or S to brake • SPACE for nitro • P to pause.</div>
 </div>
 <div class="text-center text-xs text-slate-500">TURBO RUSH • ARCADE EDITION • Avoid collisions and beat your record!</div>
</div>
<script>
(()=>{
const root=document.getElementById('turbo-rush');
if(root.dataset.ready)return;root.dataset.ready='1';
const $=id=>root.querySelector('#tr-'+id);
const canvas=$('canvas'),ctx=canvas.getContext('2d');
const W=800,H=500;
let state='menu',player={x:400,y:410},speed=0,distance=0,score=0,coins=0,nitro=100,traffic=[],pickups=[],particles=[],roadOffset=0,spawn=0,coinSpawn=0,last=0,keys={},sound=true,audio=null;
let best=0;
try{best=Number(localStorage.getItem('turboRushBest'))||0}catch(e){}
$('best').textContent=best;
const levels={easy:{max:165,acc:85,traffic:1.3},normal:{max:205,acc:95,traffic:1.8},hard:{max:245,acc:110,traffic:2.5},extreme:{max:280,acc:125,traffic:3.1}};
let difficulty='normal',baseMax=205;
function beep(freq=440,duration=.08,type='sine'){
 if(!sound)return;
 try{audio=audio||new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();let o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.value=freq;g.gain.value=.055;o.connect(g);g.connect(audio.destination);o.start();g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+duration);o.stop(audio.currentTime+duration)}catch(e){}
}
function reset(){
 player={x:400,y:410};speed=0;distance=0;score=0;coins=0;nitro=100;traffic=[];pickups=[];particles=[];roadOffset=0;spawn=.8;coinSpawn=2;last=0;
 updateHUD();
}
function start(){reset();state='playing';$('overlay').style.display='none';beep(550,.15)}
function end(){
 state='over';speed=0;beep(130,.4,'sawtooth');
 if(score>best){best=score;$('best').textContent=best;try{localStorage.setItem('turboRushBest',best)}catch(e){}}
 $('message').textContent='Race over! Final score: '+score+' • Coins collected: '+coins+'. Try again and beat your record!';
 $('start').textContent='↻ RACE AGAIN';$('overlay').style.display='flex';
}
function pause(){
 if(state==='playing'){state='paused';$('message').textContent='Take a break. Your race is paused.';$('start').textContent='▶ RESUME RACE';$('overlay').style.display='flex'}
 else if(state==='paused'){state='playing';$('overlay').style.display='none'}
}
function roadBounds(y){
 let t=(y/H);let half=145+60*t;return {left:400-half,right:400+half};
}
function drawRoad(){
 ctx.fillStyle='#28603a';ctx.fillRect(0,0,W,H);
 for(let i=0;i<20;i++){let y=(i*32+roadOffset*1.2)%H;ctx.fillStyle=i%2?'#285d37':'#2c653b';ctx.fillRect(0,y,800,18)}
 let top=roadBounds(0),bottom=roadBounds(H);
 ctx.fillStyle='#55575c';ctx.beginPath();ctx.moveTo(top.left,0);ctx.lineTo(top.right,0);ctx.lineTo(bottom.right,H);ctx.lineTo(bottom.left,H);ctx.closePath();ctx.fill();
 // road edge strips
 ctx.strokeStyle='#f8fafc';ctx.lineWidth=9;ctx.beginPath();ctx.moveTo(top.left,0);ctx.lineTo(bottom.left,H);ctx.moveTo(top.right,0);ctx.lineTo(bottom.right,H);ctx.stroke();
 // dashed lane lines
 ctx.strokeStyle='#e7e7d5';ctx.lineWidth=5;ctx.setLineDash([35,30]);ctx.lineDashOffset=-roadOffset*2;
 for(let lane=1;lane<=2;lane++){let xt=top.left+(top.right-top.left)*lane/3,xb=bottom.left+(bottom.right-bottom.left)*lane/3;ctx.beginPath();ctx.moveTo(xt,0);ctx.lineTo(xb,H);ctx.stroke()}
 ctx.setLineDash([]);
 // roadside trees
 for(let i=0;i<14;i++){let y=(i*48+roadOffset*1.6)%H;let t=y/H;let b=roadBounds(y);for(let side of [-1,1]){let x=side===-1?b.left-30-t*28:b.right+30+t*28;ctx.fillStyle='#553c25';ctx.fillRect(x-4,y-5,8,17);ctx.fillStyle='#14532d';ctx.beginPath();ctx.arc(x,y-13,12+t*5,0,Math.PI*2);ctx.fill()}}
}
function car(x,y,color,scale=1,isPlayer=false){
 ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);
 // shadow
 ctx.fillStyle='#0008';ctx.beginPath();ctx.ellipse(0,5,25,39,0,0,Math.PI*2);ctx.fill();
 ctx.fillStyle='#171717';ctx.fillRect(-25,-27,8,20);ctx.fillRect(17,-27,8,20);ctx.fillRect(-25,12,8,19);ctx.fillRect(17,12,8,19);
 let grad=ctx.createLinearGradient(-23,0,23,0);grad.addColorStop(0,'#333');grad.addColorStop(.5,color);grad.addColorStop(1,'#222');ctx.fillStyle=grad;
 ctx.beginPath();ctx.moveTo(-20,32);ctx.lineTo(-23,8);ctx.lineTo(-18,-29);ctx.quadraticCurveTo(0,-37,18,-29);ctx.lineTo(23,8);ctx.lineTo(20,32);ctx.closePath();ctx.fill();
 ctx.fillStyle='#101c2a';ctx.beginPath();ctx.moveTo(-15,-10);ctx.lineTo(-12,-25);ctx.quadraticCurveTo(0,-29,12,-25);ctx.lineTo(15,-10);ctx.closePath();ctx.fill();
 ctx.fillStyle='#7dd3fc';ctx.fillRect(-14,-8,28,12);
 ctx.fillStyle=isPlayer?'#fff7ed':'#fca5a5';ctx.fillRect(-17,22,8,5);ctx.fillRect(9,22,8,5);
 if(isPlayer){ctx.fillStyle='#facc15';ctx.fillRect(-17,-31,9,4);ctx.fillRect(8,-31,9,4)}
 ctx.restore();
}
function draw(){
 ctx.clearRect(0,0,W,H);drawRoad();
 pickups.forEach(p=>{ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.spin);ctx.fillStyle='#facc15';ctx.beginPath();ctx.arc(0,0,13,0,Math.PI*2);ctx.fill();ctx.fillStyle='#854d0e';ctx.font='bold 16px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('$',0,1);ctx.restore()});
 traffic.forEach(c=>car(c.x,c.y,c.color,c.scale));
 particles.forEach(p=>{ctx.globalAlpha=Math.max(0,p.life);ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,4,4)});ctx.globalAlpha=1;
 if(state!=='menu')car(player.x,player.y,'#f97316',1.15,true);
 if(state==='playing'&&keys.boost&&nitro>0){ctx.fillStyle='#67e8f9';ctx.beginPath();ctx.moveTo(player.x-12,player.y+31);ctx.lineTo(player.x,player.y+57+Math.random()*13);ctx.lineTo(player.x+12,player.y+31);ctx.fill()}
}
function updateHUD(){
 $('speed').textContent=Math.round(speed);
 $('distance').textContent=Math.floor(distance);
 $('score').textContent=Math.floor(score);
 $('coins').textContent=coins;
 $('nitro').style.width=nitro+'%';$('nitro-label').textContent=Math.floor(nitro)+'%';
}
function spawnTraffic(){
 let lanes=[310,400,490];let lane=lanes[Math.floor(Math.random()*3)];
 traffic.push({x:lane+(Math.random()-.5)*25,y:-60,color:['#3b82f6','#e11d48','#a855f7','#eab308','#f8fafc'][Math.floor(Math.random()*5)],scale:.9+Math.random()*.18,vy:.75+Math.random()*.65});
}
function spawnCoin(){let lanes=[310,400,490];pickups.push({x:lanes[Math.floor(Math.random()*3)],y:-25,spin:0})}
function update(dt){
 const cfg=levels[difficulty];
 let accelerating=keys.gas||keys.up,braking=keys.brake||keys.down,boosting=keys.boost&&nitro>0;
 if(accelerating)speed=Math.min(cfg.max,speed+cfg.acc*dt);
 else speed=Math.max(0,speed-23*dt);
 if(braking)speed=Math.max(0,speed-150*dt);
 if(boosting){speed=Math.min(cfg.max*1.25,speed+180*dt);nitro=Math.max(0,nitro-29*dt)}
 else nitro=Math.min(100,nitro+7*dt);
 let steer=(keys.right?1:0)-(keys.left?1:0);
 player.x+=steer*(270+speed*.7)*dt;
 let b=roadBounds(player.y);player.x=Math.max(b.left+24,Math.min(b.right-24,player.x));
 let factor=.22+speed/cfg.max*1.8;
 roadOffset+=speed*dt*.09;
 distance+=speed*dt/3.6;
 score+=speed*dt*.15;
 spawn-=dt;
 if(spawn<=0){spawnTraffic();spawn=Math.max(.48,1.65/speed*110+Math.random()*.6)/cfg.traffic}
 coinSpawn-=dt;if(coinSpawn<=0){spawnCoin();coinSpawn=2.2+Math.random()*2}
 traffic.forEach(c=>c.y+=(speed*.65+65*c.vy)*dt);
 pickups.forEach(p=>{p.y+=speed*.7*dt+70*dt;p.spin+=dt*3});
 traffic=traffic.filter(c=>c.y<H+80);
 pickups=pickups.filter(p=>p.y<H+30);
 for(let c of traffic){
  if(Math.abs(c.x-player.x)<38&&Math.abs(c.y-player.y)<48){end();return}
 }
 for(let p of pickups){if(!p.taken&&Math.abs(p.x-player.x)<34&&Math.abs(p.y-player.y)<40){p.taken=true;coins++;score+=100;nitro=Math.min(100,nitro+12);beep(880,.08)}}
 pickups=pickups.filter(p=>!p.taken);
 particles.forEach(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt});
 particles=particles.filter(p=>p.life>0);
 updateHUD();
}
function frame(t){
 let dt=Math.min((t-last)/1000||0,.035);last=t;
 if(state==='playing')update(dt);
 draw();requestAnimationFrame(frame);
}
function bindHold(id,key){
 const el=$(id);
 const down=e=>{e.preventDefault();keys[key]=true};
 const up=e=>{e.preventDefault();keys[key]=false};
 el.addEventListener('pointerdown',down);
 ['pointerup','pointerleave','pointercancel'].forEach(ev=>el.addEventListener(ev,up));
}
bindHold('left','left');bindHold('right','right');bindHold('gas','gas');bindHold('brake','brake');bindHold('boost','boost');
window.addEventListener('keydown',e=>{
 let map={ArrowLeft:'left',a:'left',ArrowRight:'right',d:'right',ArrowUp:'up',w:'up',ArrowDown:'down',s:'down', ' ':'boost'};
 let k=map[e.key];if(k){keys[k]=true;e.preventDefault()}
 if((e.key==='p'||e.key==='P')&&(state==='playing'||state==='paused'))pause();
 if(e.key==='Enter'&&(state==='menu'||state==='over'))start();
});
window.addEventListener('keyup',e=>{
 let map={ArrowLeft:'left',a:'left',ArrowRight:'right',d:'right',ArrowUp:'up',w:'up',ArrowDown:'down',s:'down',' ':'boost'};
 if(map[e.key])keys[map[e.key]]=false;
});
$('start').addEventListener('click',()=>{if(state==='paused'){pause();return}start()});
$('pause').addEventListener('click',()=>{if(state==='playing'||state==='paused')pause()});
$('restart').addEventListener('click',start);
$('difficulty').addEventListener('change',e=>{difficulty=e.target.value});
$('sound').addEventListener('click',()=>{sound=!sound;$('sound').textContent=sound?'🔊 Sound ON':'🔇 Sound OFF';if(sound)beep()});
$('overlay').addEventListener('click',e=>{if(e.target===$('overlay')&&state==='paused')pause()});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='playing')pause()});
reset();draw();requestAnimationFrame(frame);
})();
</script>
